{
  "name": "jr-delay-notify",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "JR_STATE",
      "id": "REPLACE_WITH_KV_ID",
      "preview_id": "REPLACE_WITH_PREVIEW_KV_ID"
    }
  ],
  // Cron schedules are in UTC (Cloudflare requirement). JST = UTC+9.
  // Cloudflare cron uses named weekdays to avoid numeric DOW ambiguity.
  // The morning block's UTC Sunday-Thursday runs on Monday-Friday morning in JST.
  // UTC Monday-Friday 00:00 and 05:00-10:59 are also Monday-Friday in JST.
  "triggers": {
    "crons": [
      "*/5 21-23 * * SUN-THU", // UTC Sun-Thu 21:00-23:59 = JST Mon-Fri 06:00-08:59 (morning commute)
      "0 0 * * MON-FRI", // UTC Mon-Fri 00:00       = JST Mon-Fri 09:00       (morning commute end)
      "*/5 5-10 * * MON-FRI" // UTC Mon-Fri 05:00-10:59 = JST Mon-Fri 14:00-19:59 (evening commute)
    ]
    // Note: JST 09:01–13:59 is intentionally not covered (midday gap).
    // A disruption that clears mid-morning won't trigger a recovery notice until 14:00.
    // Accepted trade-off: this is a commute-time monitor, not a 24-hour service.
  },
  "vars": {
    "NOTIFY_ON_RECOVERY": "true"
  }
}
